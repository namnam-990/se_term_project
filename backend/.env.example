# ─── 복사해서 .env 로 사용하세요. .env 는 절대 커밋하지 않습니다. ───
APP_ENV=local
APP_DEBUG=true

# MySQL 8.0 (docker compose 기본값과 일치)
DATABASE_URL=mysql+pymysql://lsrs:lsrs_pw@127.0.0.1:3306/lsrs?charset=utf8mb4

# JWT (요구사항 4.5: Access 1시간 / Refresh 7일)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 쿠키 (로컬 http 개발 시 false, 배포 HTTPS 시 true)
COOKIE_SECURE=false

# 메일 (MAIL_BACKEND=console 이면 인증 코드를 서버 콘솔에 출력 → 로컬 개발용)
MAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@lsrs.local
ALLOWED_EMAIL_DOMAIN=

# 시드 관리자 계정 (scripts/seed.py)
SEED_ADMIN_LOGIN_ID=admin
SEED_ADMIN_PASSWORD=Admin!2345
